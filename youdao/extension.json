{
  "manifestVersion": 1,
  "id": "local.youdao",
  "name": "有道翻译",
  "version": "0.1.5",
  "description": "直接输入 yd + 内容，在主搜索框查看有道官方译文。",
  "runtime": "standard-js",
  "sdk": "0.1",
  "icon": "character.bubble",
  "entry": "src/index.ts",
  "commands": [
    {
      "id": "translate",
      "title": "有道翻译",
      "keywords": ["yd"],
      "debounceMs": 500
    }
  ],
  "permissions": {
    "network": ["https://openapi.youdao.com"],
    "clipboard": ["write"]
  },
  "preferences": [
    {
      "name": "appKey",
      "title": "应用 ID",
      "type": "text",
      "required": true
    },
    {
      "name": "appSecret",
      "title": "应用密钥",
      "type": "secret",
      "required": true
    },
    {
      "name": "target",
      "title": "目标语言",
      "type": "dropdown",
      "defaultValue": "auto",
      "options": ["auto", "zh-CHS", "en", "ja", "ko", "fr", "de", "es"]
    }
  ]
}
