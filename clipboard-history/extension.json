{
  "manifestVersion": 1,
  "id": "local.clipboard-history",
  "name": "剪贴板历史",
  "version": "0.2.2",
  "description": "本地保存文本、链接和图片剪贴板；支持类型筛选、完整预览、复制与粘贴。最多 200 条、保留 7 天，停用后停止记录。",
  "runtime": "standard-js",
  "sdk": "0.1",
  "icon": "clipboard",
  "entry": "src/index.ts",
  "commands": [
    {
      "id": "history",
      "title": "剪贴板历史",
      "keywords": [
        "cb"
      ],
      "debounceMs": 200,
      "acceptsEmptyQuery": true,
      "presentation": "detail",
      "filters": [
        {
          "id": "all",
          "title": "所有类型"
        },
        {
          "id": "text",
          "title": "文本"
        },
        {
          "id": "image",
          "title": "图片"
        },
        {
          "id": "link",
          "title": "链接"
        }
      ]
    }
  ],
  "permissions": {
    "clipboard": [
      "history",
      "history-images",
      "write",
      "paste"
    ]
  },
  "preferences": []
}
