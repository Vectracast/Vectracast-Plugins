{
  "manifestVersion": 1,
  "id": "local.fanbar",
  "name": "FanBar 风扇控制",
  "version": "0.2.0",
  "description": "在 Vectracast 中查看 FanBar 风扇状态、切换散热预设、设置转速并恢复自动控制。",
  "runtime": "standard-js",
  "sdk": "0.1",
  "icon": "fanblades.fill",
  "entry": "src/index.ts",
  "commands": [
    {
      "id": "fanbar",
      "title": "FanBar 风扇控制",
      "keywords": [
        "fanbar",
        "cooling",
        "temperature",
        "fan-control",
        "mac-fan"
      ],
      "acceptsEmptyQuery": true,
      "presentation": "list",
      "searchPlaceholder": "搜索 FanBar…",
      "icon": "fanblades.fill"
    }
  ],
  "permissions": {
    "fanbar": ["read", "manage"],
    "applications": ["read", "open"],
    "browser": ["open"]
  },
  "preferences": []
}
