{
  "manifestVersion": 1,
  "id": "local.text-tools",
  "name": "文本工具",
  "version": "0.1.3",
  "description": "输入 up 后接文字，直接转换大小写并选择复制。",
  "runtime": "standard-js",
  "sdk": "0.1",
  "icon": "textformat",
  "entry": "src/index.ts",
  "commands": [
    {
      "id": "transform",
      "title": "文本转换",
      "keywords": ["up"],
      "debounceMs": 0
    }
  ],
  "permissions": {
    "clipboard": ["write"]
  },
  "preferences": []
}
